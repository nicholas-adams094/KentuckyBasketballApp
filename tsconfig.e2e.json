{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,

    // Playwright specs run in Node, but `page.evaluate` callbacks are serialised and
    // executed in the browser, so these files legitimately reference both DOM and Node
    // globals.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["tests/e2e", "playwright.config.ts"]
}
